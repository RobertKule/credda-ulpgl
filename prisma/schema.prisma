generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  password      String
  role          Role           @default(USER)
  status        AccountStatus  @default(PENDING)
  phone         String?
  organization  String?
  bio           String?
  image         String?
  requestedRole String?
  createdAt     DateTime       @default(now())
  clinicalCases ClinicalCase[]
  auditLogs     AuditLog[]
}

model Program {
  id           String               @id @default(cuid())
  slug         String               @unique
  published    Boolean              @default(false)
  featured     Boolean              @default(false)
  mainImage    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ProgramTranslation[]

  @@index([slug])
}

model ProgramTranslation {
  id          String  @id @default(cuid())
  language    String
  title       String
  description String
  content     String?
  programId   String
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, language])
}

model Media {
  id             String        @id @default(cuid())
  type           MediaType     @default(IMAGE)
  url            String
  title          String?
  articleId      String?
  clinicalCaseId String?
  createdAt      DateTime      @default(now())
  article        Article?      @relation(fields: [articleId], references: [id])
  clinicalCase   ClinicalCase? @relation(fields: [clinicalCaseId], references: [id])
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  articles     Article[]
  translations CategoryTranslation[]
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  language   String
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
}

model Article {
  id           String               @id @default(cuid())
  slug         String               @unique
  domain       Domain               @default(RESEARCH)
  published    Boolean              @default(false)
  featured     Boolean              @default(false)
  mainImage    String?
  videoUrl     String?
  categoryId   String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  category     Category             @relation(fields: [categoryId], references: [id])
  translations ArticleTranslation[]
  medias       Media[]

  @@index([slug])
}

model ArticleTranslation {
  id        String        @id @default(cuid())
  language  String
  title     String
  content   String
  excerpt   String?
  status    ContentStatus @default(DRAFT)
  articleId String
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, language])
}

model Publication {
  id           String                   @id @default(cuid())
  slug         String                   @unique
  year         Int
  doi          String?                  @unique
  pdfUrl       String
  domain       Domain                   @default(RESEARCH)
  createdAt    DateTime                 @default(now())
  translations PublicationTranslation[]
}

model PublicationTranslation {
  id            String        @id @default(cuid())
  language      String
  title         String
  authors       String
  description   String
  content       String?
  status        ContentStatus @default(DRAFT)
  publicationId String
  publication   Publication   @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, language])
}

model Member {
  id           String              @id @default(cuid())
  image        String?
  email        String?
  order        Int                 @default(0)
  name         String              @default("")
  slug         String              @unique @default("")
  facebook     String?
  linkedin     String?
  tiktok       String?
  twitter      String?
  website      String?
  whatsapp     String?
  youtube      String?
  translations MemberTranslation[]
}

model MemberTranslation {
  id           String  @id @default(cuid())
  language     String
  name         String?
  role         String
  bio          String?
  memberId     String
  education    String?
  expertise    String?
  researchAxes String?
  member       Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, language])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("UNREAD") // "UNREAD" | "READ" | "ARCHIVED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model Beneficiary {
  id        String          @id @default(cuid())
  name      String
  email     String?
  phone     String
  location  String
  type      BeneficiaryType @default(LOCAL_COMMUNITY)
  userId    String?         @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cases     ClinicalCase[]
}

model ClinicalCase {
  id            String       @id @default(cuid())
  title         String
  description   String
  problemType   String
  location      String
  incidentDate  DateTime?
  status        CaseStatus   @default(NEW)
  urgency       UrgencyLevel @default(MEDIUM)
  actionsTaken  String?
  expectations  String?
  beneficiaryId String
  clinicianId   String?
  assignedToId  String?
  trackingCode  String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  notes         CaseNote[]
  beneficiary   Beneficiary  @relation(fields: [beneficiaryId], references: [id])
  assignedTo    User?        @relation(fields: [assignedToId], references: [id])
  documents     Media[]

  @@index([status])
  @@index([urgency])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  metadata  Json?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
}

model CaseNote {
  id           String       @id @default(cuid())
  content      String
  authorId     String
  caseId       String
  createdAt    DateTime     @default(now())
  clinicalCase ClinicalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model LegalResource {
  id           String                     @id @default(cuid())
  category     String
  slug         String                     @unique
  featured     Boolean                    @default(false)
  published    Boolean                    @default(false)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  translations LegalResourceTranslation[]
}

model LegalResourceTranslation {
  id          String        @id @default(cuid())
  language    String
  title       String
  description String?
  content     String?
  fileUrl     String?
  resourceId  String
  resource    LegalResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, language])
}

model ClinicSession {
  id              String   @id @default(cuid())
  title           String
  location        String
  lat             Float?
  lng             Float?
  date            DateTime
  description     String?
  isMobile        Boolean  @default(true)
  capacity        Int      @default(50)
  registeredCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GalleryImage {
  id           String                    @id @default(cuid())
  src          String
  category     String
  order        Int                       @default(0)
  featured     Boolean                   @default(false)
  eventId      String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  event        Event?                    @relation(fields: [eventId], references: [id])
  translations GalleryImageTranslation[]

  @@index([order])
  @@index([featured])
}

model GalleryImageTranslation {
  id             String       @id @default(cuid())
  language       String
  title          String
  description    String?
  galleryImageId String
  galleryImage   GalleryImage @relation(fields: [galleryImageId], references: [id], onDelete: Cascade)

  @@unique([galleryImageId, language])
}

model Event {
  id            String             @id @default(cuid())
  slug          String             @unique
  date          DateTime
  location      String
  type          String
  coverImageUrl String?
  isPublished   Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  translations  EventTranslation[]
  galleryImages GalleryImage[]

  @@index([slug])
  @@index([date])
}

model EventTranslation {
  id          String  @id @default(cuid())
  language    String
  title       String
  description String
  content     String?
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, language])
}

model Testimonial {
  id             String                   @id @default(cuid())
  authorName     String
  authorRole     String
  avatarInitials String?
  photoUrl       String?
  isPublished    Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  translations   TestimonialTranslation[]
}

model TestimonialTranslation {
  id            String      @id @default(cuid())
  language      String
  quote         String
  testimonialId String
  testimonial   Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@unique([testimonialId, language])
}

model Announcement {
  id             String                    @id @default(uuid())
  priority       String                    @default("INFO") // "INFO" | "WARNING" | "CRITICAL"
  targetAudience String                    @default("ALL")  // "ALL" | "RESEARCHERS" | "PUBLIC"
  isPersistent   Boolean                   @default(false)
  expiresAt      DateTime?
  status         String                    @default("ACTIVE") // "ACTIVE" | "ARCHIVED" | "SCHEDULED"
  isActive       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  announcementTranslations AnnouncementTranslation[]

  @@map("announcements")
}

model AnnouncementTranslation {
  id             String       @id @default(cuid())
  language       String
  title          String?
  content        String
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, language])
}

model MediaItem {
  id           String   @id @default(uuid())
  title        String
  description  String?
  type         String   // "IMAGE" | "VIDEO"
  source       String   // "LOCAL" (Supabase Storage) | "EXTERNAL" (YouTube/Vimeo)
  url          String
  thumbnailUrl String?
  category     String   // "Conférence" | "Terrain" | "Recherche"
  createdAt    DateTime @default(now())

  @@map("media_items")
}

enum AnnouncementLevel {
  INFO
  WARNING
  URGENT
}

enum Role {
  SUPERADMIN
  ADMIN
  EDITOR
  USER
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Domain {
  RESEARCH
  CLINICAL
}

enum MediaType {
  IMAGE
  VIDEO_LINK
  DOCUMENT
}

enum ContactStatus {
  UNREAD
  READ
  ARCHIVED
}

enum CaseStatus {
  NEW
  IN_PROGRESS
  IN_ANALYSIS
  MEETING_SCHEDULED
  ACTION_ENGAGED
  RESOLVED
  CLOSED
}

enum BeneficiaryType {
  INDIGENOUS_PEOPLE
  LOCAL_COMMUNITY
  OTHER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  PENDING
}

model Gallery {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  files       GalleryFile[] // One album contains multiple files
}

model GalleryFile {
  id        String   @id @default(cuid())
  url       String   // File storage path or external URL
  fileType  String   // "IMAGE" or "VIDEO"
  galleryId String
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
}
