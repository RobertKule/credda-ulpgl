# --- AUTHENTICATION (Auth.js) ---
# Générez une clé avec : openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# --- DATABASE (Prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/credda?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/credda?schema=public"

# --- SUPABASE ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- CLOUDINARY ---
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# --- SMTP (Emails) ---
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT=587
BREVO_SMTP_USER="your_smtp_user"
BREVO_SMTP_KEY="your_smtp_key"
BREVO_FROM_EMAIL="noreply@credda-ulpgl.org"

# --- SECURITY (Scripts) ---
# Utilisé par le script scripts/create-admin.ts
MASTER_ADMIN_PASSWORD="a_very_strong_password_for_setup"

# --- APP SETTINGS ---
NEXT_PUBLIC_APP_NAME="CREDDA ULPGL"
NEXT_PUBLIC_APP_DESCRIPTION="Centre de Recherche en Eau, Développement Durable et Santé"
NODE_ENV="development"
